OPENAI_API_KEY=
url=http://117.186.43.62:5027/v1
QWEN_API_KEY=
url_qwen=http://117.186.43.62:5027/v1
AIOS_MODEL_TYPE=qwen3.6-27b
EXA_API_KEY=
ORCA_PORT=5001
AIOS_AGENT_RUNTIME=hermes
AIOS_HERMES_COMPANY=aios
AIOS_HERMES_NAMESPACE=aios
AIOS_HERMES_EMPLOYEE_ID=main
AIOS_HERMES_HOME=
AIOS_HERMES_AGENT_ROOT=
# Soul fallback policy: never, on_error, on_empty, always.
# "always" keeps the old slow debug behavior: Hermes call + Camel call every time.
AIOS_HERMES_FALLBACK=on_error
# Print Hermes event timings while debugging slow runs.
AIOS_HERMES_DEBUG=0
# Keep Hermes Soul bounded; it should enrich and hand off, not run a long autonomous loop.
AIOS_HERMES_MAX_TURNS=12
AIOS_HERMES_GATEWAY_TIMEOUT=300
AIOS_HERMES_REASONING_EFFORT=low
# Preserve Soul's ability to ask when it detects real ambiguity/conflict.
AIOS_SOUL_MAX_CLARIFICATIONS=2
AIOS_SOUL_DEFAULT_REPLY=你自己发挥
# Optional escape hatch: set to 1 only when you want to bypass Soul for a fast smoke test.
AIOS_HERMES_FAST_HANDOFF=0
# Mock demo default: publish without terminal yes/no confirmation.
AIOS_AUTO_CONFIRM_PUBLISH=1
# Generic Hermes SDK runtime data for this AIOS project.
# Leave blank to use runtime/hermes under the current project.
AIOS_HERMES_RUNTIME_DIR=
